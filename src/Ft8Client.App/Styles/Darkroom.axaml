<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels" xmlns:v="using:Ft8Client.App.Views">
  <!-- Darkroom: red on near-black for night operating, like a safelight, so the eyes stay dark-adapted. The light theme is
       rose paper with dark red ink. Colours come from the skin palette, so the faceplate follows light and dark. -->
  <Styles.Resources>
    <FontFamily x:Key="DarkroomSans">avares://Costas/Assets/Fonts#Red Hat Text</FontFamily>
    <FontFamily x:Key="DarkroomMono">avares://Costas/Assets/Fonts#Red Hat Mono</FontFamily>
    <DataTemplate x:Key="InstrumentFaceTemplate" x:DataType="vm:MainViewModel">
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="0">
        <Grid ColumnDefinitions="160,*,240" ColumnSpacing="0">
          <StackPanel Margin="18,14" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="COSTAS" FontFamily="{StaticResource DarkroomMono}" FontSize="20" LetterSpacing="5" Foreground="{DynamicResource AccentTextBrush}" />
            <TextBlock Text="NIGHT OPERATING" FontFamily="{StaticResource DarkroomMono}" FontSize="9" LetterSpacing="1.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
              <TextBlock Text="{Binding SelectedMode}" FontFamily="{StaticResource DarkroomMono}" FontSize="11" />
              <TextBlock Text="{Binding SelectedBandChoice.Name}" FontFamily="{StaticResource DarkroomMono}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0" Padding="20,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DIAL · MHz" FontFamily="{StaticResource DarkroomMono}" FontSize="9" LetterSpacing="2" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Classes="instrument-dial" IsEnabled="{Binding CanChangeBand}" ToolTip.Tip="Edit dial frequency" AutomationProperties.Name="Dial frequency">
                  <TextBlock Text="{Binding Frequency}" FontFamily="{StaticResource DarkroomMono}" FontSize="38" Foreground="{DynamicResource AccentTextBrush}" />
                </Button>
              </StackPanel>
              <v:TxFaceMeters Grid.Column="1" LabelBrush="{DynamicResource TextSecondaryBrush}" ValueBrush="{DynamicResource TextPrimaryBrush}"
                              MeterBrush="{DynamicResource TextPrimaryBrush}" CautionBrush="{DynamicResource CautionBrush}"
                              TrackBrush="{DynamicResource RowDividerBrush}" FontFamily="{StaticResource DarkroomMono}" />
              <Button Grid.Column="2" Classes="instrument-dial" Content="SET DIAL" IsEnabled="{Binding CanChangeBand}" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10,6" FontFamily="{StaticResource DarkroomMono}" FontSize="10"
                      ToolTip.Tip="Open the dial frequency editor" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="2" Margin="18,12" Spacing="8" VerticalAlignment="Center">
            <DockPanel>
              <TextBlock Text="SLOT" FontFamily="{StaticResource DarkroomMono}" FontSize="9" LetterSpacing="2" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SlotRemaining}" HorizontalAlignment="Right" FontFamily="{StaticResource DarkroomMono}" FontSize="11" />
            </DockPanel>
            <v:SlotMeter Value="{Binding SlotProgress}" Height="8" MeterBrush="{DynamicResource AccentTextBrush}" TrackBrush="{DynamicResource RowDividerBrush}" AutomationProperties.Name="Slot progress" />
            <TextBlock Classes="instrument-phase" Classes.transmitting="{Binding Transmitting}" Text="{Binding SlotLabel}" FontFamily="{StaticResource DarkroomMono}" FontSize="11" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="Window"><Setter Property="FontFamily" Value="{StaticResource DarkroomSans}" /></Style>
  <Style Selector="TextBlock.message, TextBlock.num"><Setter Property="FontFamily" Value="{StaticResource DarkroomMono}" /></Style>
  <Style Selector="Border.card"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="{StaticResource DarkroomMono}" /><Setter Property="FontSize" Value="12" /><Setter Property="LetterSpacing" Value="1.5" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
  <Style Selector="Button:not(.link):not(.wfoverlay):not(.instrument-dial), ComboBox, TextBox"><Setter Property="CornerRadius" Value="2" /></Style>
  <Style Selector="Button:not(.link):not(.wfoverlay):not(.instrument-dial):not(.tab)"><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /></Style>
  <Style Selector="Button.tab"><Setter Property="FontFamily" Value="{StaticResource DarkroomMono}" /><Setter Property="FontSize" Value="12" /></Style>
  <!-- White text on the selected tab would be the brightest thing on screen: use the window colour instead. -->
  <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource WindowBackgroundBrush}" /></Style>
  <Style Selector="TextBlock.instrument-phase"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <Style Selector="TextBlock.instrument-phase.transmitting"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.instrument-dial"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.instrument-dial /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.instrument-dial:pointerover /template/ ContentPresenter"><Setter Property="Opacity" Value="0.85" /></Style>
</Styles>
