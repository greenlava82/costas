<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Ft8Client.App.Views"
        x:Class="Ft8Client.App.Views.WaterfallWindow"
        Icon="/Assets/costas.ico"
        Title="Costas waterfall" Width="1000" Height="320" MinWidth="420" MinHeight="120" ShowInTaskbar="False">
  <!-- The popped-out waterfall. Closing it, or Pop in, puts the strip back in the main window. -->
  <Grid Margin="6">
    <v:WaterfallView x:Name="Waterfall" Cursor="Cross" LabelInset="162"
                     AutomationProperties.Name="Receive waterfall; click to select transmit channel" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <ToggleButton x:Name="CallsButton" Classes="wfoverlay" Content="Calls" IsChecked="True"
                    ToolTip.Tip="Show callsigns on the waterfall over the signals they were decoded from"
                    AutomationProperties.Name="Show callsigns on the waterfall" />
      <Button x:Name="LevelsButton" Classes="wfoverlay" Content="Levels"
              ToolTip.Tip="Waterfall contrast: the darkest level and the range" AutomationProperties.Name="Waterfall levels">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <v:WaterfallLevelsPanel x:Name="LevelsPanel" />
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button x:Name="PopInButton" Classes="wfoverlay" Content="Pop in"
              ToolTip.Tip="Put the waterfall back in the main window" AutomationProperties.Name="Pop the waterfall back in" />
    </StackPanel>
  </Grid>
</Window>
