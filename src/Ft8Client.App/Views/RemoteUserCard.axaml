<!-- One person who may sign in to the remote page, in Settings > Mobile connection: one line with Edit and Delete, and
     the editor below it only while Edit is open, so a long list stays short. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             x:Class="Ft8Client.App.Views.RemoteUserCard"
             x:DataType="vm:RemoteUserEditViewModel">
  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource RowDividerBrush}" Padding="0,6">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Content="{Binding EditLabel}" Command="{Binding EditCommand}" MinWidth="64" HorizontalContentAlignment="Center"
                AutomationProperties.Name="{Binding DisplayName, StringFormat='Edit the user {0}'}" />
        <Button Grid.Column="3" Content="Delete" Command="{Binding RemoveCommand}"
                ToolTip.Tip="Takes the user off the list when you save. Cancel keeps them."
                AutomationProperties.Name="{Binding DisplayName, StringFormat='Delete the user {0}'}" />
      </Grid>
      <StackPanel IsVisible="{Binding IsEditing}" Spacing="8" Margin="12,0,0,6">
        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Text="Username" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding Username}" MaxLength="64" Width="240" HorizontalAlignment="Left"
                   AutomationProperties.Name="Username" />
          <TextBlock Grid.Row="1" Text="Password" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewPassword}" PasswordChar="●" Width="240" HorizontalAlignment="Left"
                   PlaceholderText="{Binding PasswordPlaceholder}"
                   AutomationProperties.Name="{Binding DisplayName, StringFormat='New password for {0}'}" />
        </Grid>
        <WrapPanel>
          <CheckBox Content="Allowed to sign in" IsChecked="{Binding Enabled}" Margin="0,0,16,4" />
          <Button Content="Sign out everywhere" Command="{Binding SignOutCommand}" IsEnabled="{Binding HasPassword}" Margin="0,0,0,4"
                  ToolTip.Tip="Ends this user's sign-in on every phone and browser now. They can sign in again."
                  AutomationProperties.Name="{Binding DisplayName, StringFormat='Sign {0} out on every device'}" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
